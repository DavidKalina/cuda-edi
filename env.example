# Non-secret placeholders for local / CDK context.
# Copy to .env (gitignored) and fill real values before deploy.

# AWS
AWS_REGION=us-west-2
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-west-2

# Job store (Postgres). Do not commit real credentials.
DATABASE_URL=postgresql://user:password@localhost:5432/cuda

# Object storage — cuda-edi owns a dedicated S3 bucket (see CDK stack).
# Payloads and Artifacts are stored there; queue messages carry refs only.
EDI_ARTIFACTS_BUCKET=

# Enqueue Lambda name/ARN (filled after deploy; used by Enqueue SDK)
EDI_ENQUEUE_FUNCTION_NAME=cuda-edi-enqueue-dev

# Optional: Secrets Manager ARN for DATABASE_URL in Lambda env
EDI_DB_SECRET_ARN=
